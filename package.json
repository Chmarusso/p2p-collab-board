{
  "name": "opencollab-electron",
  "productName": "OpenCollab",
  "version": "1.0.5",
  "upgrade": "pear://nzi3suuxyzwj6oosortonj5pxd9s7ckgd8cr87szddaamxi77kny",
  "description": "Private peer-to-peer collaboration boards",
  "license": "",
  "author": "",
  "type": "commonjs",
  "main": "electron/main.js",
  "private": true,
  "imports": {
    "pear-runtime": {
      "ios": "pear-mobile",
      "android": "pear-mobile",
      "simulator": "pear-mobile",
      "default": "pear-runtime"
    }
  },
  "workspaces": [
    "apps/mobile",
    "apps/cli",
    "packages/*"
  ],
  "scripts": {
    "lint": "prettier --check . && lunte",
    "format": "prettier --write . && lunte --fix",
    "test:clipboard": "node scripts/test-clipboard-integration.mjs",
    "test:recent-board-name": "node scripts/test-recent-board-name.mjs",
    "test:board-replication": "npm run test:autobee-replication",
    "test:autobee-replication": "node scripts/test-autobee-replication.mjs",
    "test:kanban": "node scripts/test-themes.mjs && node scripts/test-kanban-convergence.mjs && node scripts/test-kanban-alerts.mjs && node scripts/test-kanban-worker.mjs",
    "test:kanban-peers": "node scripts/test-kanban-peers.mjs",
    "test:board-spaces": "node scripts/test-board-spaces.mjs",
    "dev:worst-case": "node scripts/worst-case-board.mjs",
    "relay": "node scripts/board-relay.mjs",
    "start": "electron-forge start -- --no-updates",
    "package": "electron-forge package",
    "make": "electron-forge make",
    "install:all": "npm i --ignore-scripts=true && npm run postinstall:all",
    "install:mac": "npm i --ignore-scripts=true && npm run postinstall:mac",
    "postinstall:all": "npm run install:electron",
    "postinstall:mac": "npm run postinstall:all && npm run install:macos-alias && npm run install:fs-xattr",
    "install:electron": "node node_modules/electron/install.js",
    "install:macos-alias": "cd node_modules/macos-alias && node-gyp rebuild",
    "install:fs-xattr": "cd node_modules/fs-xattr && node-gyp rebuild",
    "cli": "node apps/cli/bin.js",
    "test:blind-peer": "node scripts/test-blind-peer.mjs"
  },
  "dependencies": {
    "@highlightjs/cdn-assets": "^11.12.0",
    "@opencollab/board-protocol": "file:packages/board-protocol",
    "autobee": "^2.12.1",
    "blind-peering": "^2.12.0",
    "dompurify": "^3.4.17",
    "framed-stream": "^1.0.1",
    "hello-pear-worker": "^1.0.0",
    "hyperblobs": "^2.12.1",
    "hypercore-crypto": "^3.7.0",
    "keet-identity-key": "^3.2.0",
    "keytar": "^7.9.0",
    "marked": "^15.0.12",
    "paparam": "^1.10.0",
    "pear-runtime": "^1.1.4",
    "protomux-wakeup": "^2.9.0",
    "sodium-native": "^5.1.0",
    "which-runtime": "^1.3.2"
  },
  "overrides": {
    "bare-type": "1.1.1"
  },
  "devDependencies": {
    "@electron-forge/cli": "^7.11.1",
    "@electron-forge/maker-deb": "^7.11.1",
    "@electron-forge/maker-dmg": "^7.11.1",
    "@electron-forge/maker-msix": "^7.11.1",
    "@electron-forge/maker-rpm": "^7.11.1",
    "@electron-forge/maker-zip": "^7.11.1",
    "@electron/node-gyp": "git+ssh://git@github.com/electron/node-gyp.git#06b29aafb7708acef8b3669835c8a7857ebc92d2",
    "app-builder-lib": "^26.8.1",
    "electron": "^40.2.1",
    "electron-forge-plugin-prune-prebuilds": "^1.0.0",
    "electron-forge-plugin-universal-prebuilds": "^1.0.0",
    "lunte": "^1.6.0",
    "pear-electron-forge-maker-appimage": "^2.0.0",
    "pear-electron-forge-maker-flatpak": "^0.0.6",
    "pear-electron-forge-maker-snap": "^1.0.0",
    "prettier": "^3.8.1",
    "prettier-config-holepunch": "^2.0.0"
  },
  "allowScripts": {
    "electron@40.10.1": true,
    "electron-winstaller": false
  }
}
